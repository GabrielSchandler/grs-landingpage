## ==========================================
## OBRIGATORIO - Google Sheets
## ==========================================
# URL do Web App publicado no Google Apps Script.
# Exemplo: https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_SHEETS_WEBHOOK_URL=

# Segredo compartilhado entre a API do Next.js e o Apps Script.
# Use uma frase/senha longa e aleatoria. Nao use NEXT_PUBLIC aqui.
GOOGLE_SHEETS_WEBHOOK_SECRET=

## ==========================================
## OBRIGATORIO - WhatsApp Business
## ==========================================
# Formato: pais (55) + DDD + numero, sem simbolos.
# Exemplo: 5511963322546 para (11) 96332-2546
# Se deixar vazio, o site usa o numero padrao da GRS: 5511963322546.
NEXT_PUBLIC_WHATSAPP_NUMBER=5511963322546

## ==========================================
## RECOMENDADO - Rastreamento & Analytics
## ==========================================

# Google Tag Manager (GTM)
# Obter em: https://tagmanager.google.com
# Formato: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics 4
# Obter em: https://analytics.google.com
# Formato: G-XXXXXXX
NEXT_PUBLIC_GA4_ID=G-XXXXXXX

# Google Ads Conversion Tracking
# Obter em: https://ads.google.com > Conversao
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL_LEAD=

# Meta/Facebook Pixel
# Obter em: https://business.facebook.com > Pixels
NEXT_PUBLIC_META_PIXEL_ID=

## ==========================================
## OPCIONAL - Seguranca (Form Protection)
## ==========================================

# reCAPTCHA v3 (previne bots)
# Obter em: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Secret key (manter privada, usar apenas no servidor)
RECAPTCHA_SECRET_KEY=

## ==========================================
## AMBIENTE
## ==========================================
NODE_ENV=development
