## ==========================================
## OBRIGATÓRIO - Supabase
## ==========================================
# Get from: https://app.supabase.com > Project Settings > API keys
# URL: Copy from "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# ANON KEY: Copy "anon" key (public, safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...your-anon-key

## ==========================================
## OBRIGATÓRIO - WhatsApp Business (para CTAs funcionarem)
## ==========================================
# Format: país (55) + DDD + número (sem símbolos)
# Exemplo: 5511987654321 para (11) 98765-4321
# Se deixar vazio, CTAs de WhatsApp caem para formulário
NEXT_PUBLIC_WHATSAPP_NUMBER=5511987654321

## ==========================================
## RECOMENDADO - Rastreamento & Analytics
## ==========================================

# Google Tag Manager (GTM)
# Obter em: https://tagmanager.google.com
# Format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics 4
# Obter em: https://analytics.google.com
# Format: G-XXXXXXX
NEXT_PUBLIC_GA4_ID=G-XXXXXXX

# Google Ads Conversion Tracking
# Obter em: https://ads.google.com > Conversão
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL_LEAD=

# Meta/Facebook Pixel
# Obter em: https://business.facebook.com > Pixels
NEXT_PUBLIC_META_PIXEL_ID=

## ==========================================
## OPCIONAL - Segurança (Form Protection)
## ==========================================

# reCAPTCHA v3 (previne bots)
# Obter em: https://www.google.com/recaptcha/admin
# Site key (public, safe for browser)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Secret key (keep secret, use only on server)
RECAPTCHA_SECRET_KEY=

## ==========================================
## AMBIENTE
## ==========================================
NODE_ENV=development

